# Production settings for the API on Hostinger (api.reenite.com).
# Copy to .env on the server, fill the blanks, then run: php artisan key:generate
# Never commit the real .env. Payment keys and email (SMTP) settings are NOT here:
# enter them in the website under Admin > Settings once you are signed in.

APP_NAME=Reenite
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.reenite.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG
APP_TIMEZONE_DISPLAY=Africa/Lagos
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# The website's address: links in emails point here.
FRONTEND_URL=https://app.reenite.com

# Shared with the website (Vercel env INTERNAL_API_KEY). Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# Only the server itself; the website proves itself with INTERNAL_API_KEY instead.
TRUSTED_PROXIES=127.0.0.1,::1

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# MySQL database created in hPanel > Databases > MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Shared hosting can't keep a queue worker running, so cron starts one every minute.
QUEUE_CONNECTION=database
QUEUE_FROM_SCHEDULER=true

# Fallback only: real delivery is set in Admin > Settings > Email delivery.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@reenite.com"
MAIL_FROM_NAME="${APP_NAME}"
