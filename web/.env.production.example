# Environment variables for the website on Vercel (Project > Settings > Environment Variables).
# Add each line below as a variable for the Production environment.

# The API on Hostinger.
API_URL=https://api.reenite.com

# This website's own address, without www (used for links, the sitemap, share previews and QR codes).
NEXT_PUBLIC_SITE_URL=https://reenite.com

# Same value as INTERNAL_API_KEY in the API's .env.
INTERNAL_API_KEY=

# Android app (Play Store package com.reenite.app). The SHA-256 fingerprints from
# Play Console > Test and release > App integrity > App signing: the app signing key, then the upload key,
# separated by a comma. They let the app open reenite.com full screen without a browser address bar.
ANDROID_PACKAGE_NAME=com.reenite.app
ANDROID_SHA256_FINGERPRINTS=
